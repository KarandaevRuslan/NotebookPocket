{
  "name": "notebook-pocket-web",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:codemirror && npm run check:acode && vite build --mode editor && vite build --mode preview && node ./scripts/verify-vite-assets.mjs && node ./copy-android.mjs",
    "test": "node --test ./tests/*.test.mjs",
    "test:built-preview": "node ./scripts/smoke-built-preview.mjs",
    "check:codemirror": "node ./scripts/verify-codemirror.mjs",
    "check:acode": "node ./scripts/verify-acode-port.mjs",
    "test:upstream": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.11.3",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.1",
    "@observablehq/inputs": "1.0.0",
    "@observablehq/notebook-kit": "2.9.1",
    "dompurify": "3.4.18",
    "htl": "1.0.0",
    "html-tag-js": "^2.4.16",
    "motion": "^12.23.24",
    "nexus": "file:vendor/nexus-0.1.20.tgz",
    "vanilla-picker": "2.12.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/parser": "^7.28.5",
    "esbuild": "^0.25.12",
    "happy-dom": "21.0.4",
    "jsdom": "^26.1.0",
    "sass": "^1.93.3",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.43.14"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  }
}
